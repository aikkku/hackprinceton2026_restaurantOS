{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000 {
		# Preserve the public Host for the app's existing same-origin guards.
		header_up Host {host}
		flush_interval -1
	}
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
}
