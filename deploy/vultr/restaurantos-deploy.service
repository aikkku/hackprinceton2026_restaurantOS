[Unit]
Description=Deploy RestaurantOS after successful main verification
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/restaurantos/autodeploy.py
TimeoutStartSec=40min
TimeoutStopSec=30
UMask=0077
Environment=GIT_TERMINAL_PROMPT=0
