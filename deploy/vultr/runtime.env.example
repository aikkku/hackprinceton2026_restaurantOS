# Copy to /opt/restaurantos/runtime.env OUTSIDE the checkout; chmod 600.
# Do not put live secrets in this example or commit the filled file.
TACTICAL_DATA_SOURCE=mongodb
TACTICAL_RESTAURANT_ID=juniper-table
MONGODB_URI=
MONGODB_DB=restaurantos
# Use DIFFERENT random values, each >=32 chars. UI password is shared with judges;
# the administrative API token is never shared with judges/browser users.
TACTICAL_AI_PASSWORD=
TACTICAL_API_TOKEN=
EXPANSION_SESSION_SECRET=
EXPANSION_ACCESS_CODE=
EXPANSION_PERSISTENCE=mongodb
GEMINI_API_KEY=
TACTICAL_AI_MODEL=gemini-2.5-flash
EXPANSION_AGENT_PROVIDER=google
EXPANSION_AGENT_MODEL_ID=gemini-2.5-flash
# Optional: missing keys fail honestly; no fake successful provider responses.
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=
# Expansion private dataset is provisioned separately by Rain, not in the image.
EXPANSION_DB_PATH=/data/expansion.sqlite
EXPANSION_COSTAR_ROOT=/data/costar-kit
EXPANSION_DATASET_ID=
EXPANSION_DATASET_DATE=
EXPANSION_SOURCE_NETWORK=0
EXPANSION_VEXCEL_DISPLAY=0
