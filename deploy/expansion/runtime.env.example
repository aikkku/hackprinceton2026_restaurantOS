# Expansion runtime environment — NAMES ONLY. Fill values from your secret
# manager into a file kept OUTSIDE the repository (or the host's env settings).
# Never commit values.

# --- Required in production ---
# Signs the HttpOnly owner cookie (>= 32 random characters).
EXPANSION_SESSION_SECRET=
# Shared RestaurantOS MongoDB (Expansion uses only expansion_* collections).
MONGODB_URI=
MONGODB_DB=restaurantos

# --- Strongly recommended ---
# Gate new owner sessions behind a shared access code (demo/pilot deployments).
EXPANSION_ACCESS_CODE=
# Live Deep Agents model provider key (one of these). Without it live runs fail
# honestly and the deterministic search remains available.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# EXPANSION_AGENT_PROVIDER=google
# EXPANSION_AGENT_MODEL_ID=gemini-2.5-flash

# --- Dataset (private, on the persistent volume; import on the host) ---
EXPANSION_DB_PATH=/data/expansion.sqlite
EXPANSION_COSTAR_ROOT=/data/costar-kit
EXPANSION_DATASET_ID=
EXPANSION_DATASET_DATE=

# --- Worker/run store (defaults shown in the Dockerfile) ---
# EXPANSION_AGENT_RUNS_DIR=/data/runs
# EXPANSION_AGENT_PYTHON=/opt/worker-venv/bin/python
# EXPANSION_AGENT_BRIDGE_URL=http://127.0.0.1:3000
# EXPANSION_AGENT_RUN_TIMEOUT_S=900
# EXPANSION_AGENT_EVIDENCE=1        # 0 disables Phase 4 evidence on agent runs
# EXPANSION_PERSISTENCE=mongodb     # mongodb | file | off (auto: mongodb when MONGODB_URI is set)

# --- Optional live source probes (off unless explicitly permitted) ---
# EXPANSION_SOURCE_NETWORK=1
# EXPANSION_VEXCEL_DISPLAY=1
# EXPANSION_HEIGHTS_LOOKUP=/data/heights-lookup.json
# MATTERPORT_API_KEY=
# MATTERPORT_API_TOKEN=   # HTTP Basic auth pair with MATTERPORT_API_KEY
# VEXCEL_API_KEY=
# EXPANSION_MATTERPORT_EMBED_MODELS=model1,model2   # allowlist of Matterport model IDs whose my.matterport.com viewer may be embedded
